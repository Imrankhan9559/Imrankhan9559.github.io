/* Imran Portfolio — frontend interactions */
(function () {
    "use strict";

    var doc = document;
    var root = doc.documentElement;

    /* ---------- Theme toggle (dark default, persisted) ---------- */
    function setTheme(t, save) {
        root.setAttribute("data-theme", t);
        if (save !== false) {
            try { localStorage.setItem("pf_theme", t); } catch (e) {}
        }
    }

    var saved = null;
    try { saved = localStorage.getItem("pf_theme"); } catch (e) {}
    setTheme(saved === "light" ? "light" : "dark", false);

    doc.addEventListener("click", function (ev) {
        var btn = ev.target.closest("[data-theme-toggle]");
        if (!btn) return;
        var next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
        setTheme(next);
    });

    /* ---------- Navbar scrolled state ---------- */
    var nav = doc.querySelector(".nav");
    function onScroll() {
        if (nav) nav.classList.toggle("scrolled", window.scrollY > 24);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    /* ---------- Mobile menu ---------- */
    var burger = doc.querySelector(".burger");
    var mobileMenu = doc.querySelector(".mobile-menu");
    if (burger && mobileMenu) {
        burger.addEventListener("click", function () {
            var open = nav.classList.toggle("open");
            mobileMenu.classList.toggle("open", open);
            doc.body.style.overflow = open ? "hidden" : "";
        });
        mobileMenu.querySelectorAll("a").forEach(function (a) {
            a.addEventListener("click", function () {
                nav.classList.remove("open");
                mobileMenu.classList.remove("open");
                doc.body.style.overflow = "";
            });
        });
    }

    /* ---------- Smooth anchor scroll with sticky offset ---------- */
    doc.querySelectorAll('a[href^="#"]').forEach(function (a) {
        a.addEventListener("click", function (ev) {
            var target = doc.querySelector(a.getAttribute("href"));
            if (!target) return;
            ev.preventDefault();
            var top = target.getBoundingClientRect().top + window.pageYOffset - 80;
            window.scrollTo({ top: top, behavior: "smooth" });
        });
    });

    /* ---------- Reveal on scroll ---------- */
    var revealEls = doc.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window) {
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (en.isIntersecting) {
                    en.target.classList.add("in");
                    io.unobserve(en.target);
                }
            });
        }, { threshold: 0.12 });
        revealEls.forEach(function (el) { io.observe(el); });
    } else {
        revealEls.forEach(function (el) { el.classList.add("in"); });
    }

    /* ---------- Animated counters ---------- */
    function animateCount(el) {
        var target = parseInt(el.getAttribute("data-count"), 10) || 0;
        var suffix = el.getAttribute("data-suffix") || "";
        if (isNaN(target)) { el.textContent = target + suffix; return; }
        var dur = 1300;
        var start = null;
        function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(eased * target) + suffix;
            if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    }

    var counters = doc.querySelectorAll("[data-count]");
    if ("IntersectionObserver" in window) {
        var co = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
                if (en.isIntersecting) {
                    animateCount(en.target);
                    co.unobserve(en.target);
                }
            });
        }, { threshold: 0.4 });
        counters.forEach(function (el) { co.observe(el); });
    } else {
        counters.forEach(animateCount);
    }

    /* ---------- Work filter ---------- */
    var filterBtns = doc.querySelectorAll(".filter-btn");
    var workCards = doc.querySelectorAll(".work-card");
    if (filterBtns.length) {
        filterBtns.forEach(function (btn) {
            btn.addEventListener("click", function () {
                filterBtns.forEach(function (b) { b.classList.remove("active"); });
                btn.classList.add("active");
                var f = btn.getAttribute("data-filter");
                workCards.forEach(function (card) {
                    var cat = card.getAttribute("data-cat");
                    var show = f === "all" || f === cat;
                    card.style.display = show ? "" : "none";
                });
            });
        });
    }

    /* ---------- Project modal (photos + video + whatsapp demand) ---------- */
    var projData = [];
    var projScript = doc.getElementById("projData");
    if (projScript) {
        try { projData = JSON.parse(projScript.textContent) || []; } catch (e) { projData = []; }
    }

    var modal = doc.getElementById("projModal");
    if (modal) {
        var pmMain = doc.getElementById("pmMain");
        var pmThumbs = doc.getElementById("pmThumbs");
        var pmVideo = doc.getElementById("pmVideo");
        var pmCat = doc.getElementById("pmCat");
        var pmTitle = doc.getElementById("pmTitle");
        var pmDesc = doc.getElementById("pmDesc");
        var pmTech = doc.getElementById("pmTech");
        var pmWa = doc.getElementById("pmWa");
        var pmVisit = doc.getElementById("pmVisit");
        var pmPrev = doc.getElementById("pmPrev");
        var pmNext = doc.getElementById("pmNext");

        var current = null;
        var imgIndex = 0;
        var iframe = null;

        function fillTech(list) {
            pmTech.innerHTML = "";
            (list || []).forEach(function (t) {
                var s = doc.createElement("span");
                s.textContent = t;
                pmTech.appendChild(s);
            });
        }

        function setMain() {
            var imgs = current.g;
            if (!imgs || !imgs.length) {
                pmMain.innerHTML = '<span class="ph big">' + (current.t ? current.t.charAt(0) : "?") + "</span>";
            } else {
                imgIndex = Math.min(Math.max(imgIndex, 0), imgs.length - 1);
                pmMain.innerHTML = '<img src="' + imgs[imgIndex] + '" alt="' + current.t + '">';
            }
            if (pmPrev) pmPrev.style.display = (imgs && imgs.length > 1) ? "" : "none";
            if (pmNext) pmNext.style.display = (imgs && imgs.length > 1) ? "" : "none";
            if (pmThumbs) {
                pmThumbs.innerHTML = "";
                if (imgs) {
                    imgs.forEach(function (src, i) {
                        var t = doc.createElement("button");
                        t.type = "button";
                        t.className = "pm-thumb" + (i === imgIndex ? " active" : "");
                        t.innerHTML = '<img src="' + src + '" alt="">';
                        t.addEventListener("click", function () { imgIndex = i; renderImages(); });
                        pmThumbs.appendChild(t);
                    });
                }
            }
        }

        function renderImages() {
            var imgs = current.g || [];
            setMain();
            if (pmThumbs) {
                var thumbs = pmThumbs.children;
                for (var i = 0; i < thumbs.length; i++) {
                    thumbs[i].classList.toggle("active", i === imgIndex);
                }
            }
        }

        function stopVideo() {
            if (iframe) { iframe.remove(); iframe = null; }
            if (pmVideo) pmVideo.hidden = true;
        }

        function openModal(id) {
            current = null;
            for (var i = 0; i < projData.length; i++) {
                if (projData[i].id === id) { current = projData[i]; break; }
            }
            if (!current) return;
            imgIndex = 0;
            stopVideo();
            if (pmCat) pmCat.textContent = current.c || "Case Study";
            if (pmTitle) pmTitle.textContent = current.t;
            if (pmDesc) pmDesc.textContent = current.d;
            fillTech(current.tech);
            renderImages();
            if (pmWa) {
                if (current.w) { pmWa.href = current.w; pmWa.hidden = false; }
                else pmWa.hidden = true;
            }
            if (pmVisit) {
                if (current.u) { pmVisit.href = current.u; pmVisit.hidden = false; }
                else pmVisit.hidden = true;
            }
            if (current.y && pmVideo) {
                iframe = doc.createElement("iframe");
                iframe.setAttribute("src", current.y);
                iframe.setAttribute("allow", "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share");
                iframe.setAttribute("allowfullscreen", "");
                iframe.setAttribute("loading", "lazy");
                iframe.setAttribute("title", current.t + " video");
                pmVideo.appendChild(iframe);
                pmVideo.hidden = false;
            }
            modal.hidden = false;
            doc.body.style.overflow = "hidden";
            modal.classList.add("show");
            if (modal.querySelector(".modal")) modal.querySelector(".modal").focus();
        }

        function closeModal() {
            if (!modal) return;
            modal.hidden = true;
            modal.classList.remove("show");
            stopVideo();
            doc.body.style.overflow = "";
        }

        workCards.forEach(function (card) {
            function open() { openModal(parseInt(card.getAttribute("data-proj"), 10)); }
            card.addEventListener("click", function (ev) {
                if (ev.target.closest("a")) return;
                open();
            });
            card.addEventListener("keydown", function (ev) {
                if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); open(); }
            });
        });

        if (pmPrev) pmPrev.addEventListener("click", function () { imgIndex--; renderImages(); });
        if (pmNext) pmNext.addEventListener("click", function () { imgIndex++; renderImages(); });
        doc.getElementById("projClose").addEventListener("click", closeModal);
        modal.addEventListener("click", function (ev) {
            if (ev.target === modal) closeModal();
        });
        doc.addEventListener("keydown", function (ev) {
            if (!modal.hidden && ev.key === "Escape") closeModal();
        });
    }

    /* ---------- Contact form ---------- */
    var form = doc.getElementById("contactForm");
    if (form) {
        form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var hp = form.querySelector(".hp input");
            if (hp && hp.value !== "") return;

            var btn = form.querySelector("button[type=submit]");
            var original = btn.textContent;
            btn.disabled = true;
            btn.textContent = "Sending…";

            var fd = new FormData(form);
            fd.append("action", "contact");

            fetch("index.php", { method: "POST", body: fd })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.ok) {
                        form.reset();
                        showToast("Message sent! I'll get back to you soon.");
                    } else {
                        showToast(res.error || "Something went wrong. Please try again.");
                    }
                })
                .catch(function () { showToast("Network error. Please try again."); })
                .then(function () {
                    btn.disabled = false;
                    btn.textContent = original;
                });
        });
    }

    /* ---------- Toast ---------- */
    var toastEl = doc.getElementById("toast");
    var toastTimer = null;
    function showToast(msg) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toastEl.classList.remove("show"); }, 3200);
    }

    /* ---------- Footer year ---------- */
    doc.querySelectorAll("[data-year]").forEach(function (el) {
        el.textContent = new Date().getFullYear();
    });
})();
